---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langOf } from '../../lib/content';
import type { Lang } from '../../lib/i18n';

interface Props { lang: Lang; entry: CollectionEntry<'works'> }
const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const untranslated = lang === 'en' && langOf(entry) === 'ko';
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary}>
  <main class="wrap narrow" style="margin-inline: auto;">
    <header class="head">
      <h1>{entry.data.title}</h1>
      <p class="mono meta">
        <span class={`dot ${entry.data.status}`} aria-hidden="true"></span>
        {entry.data.status} · {fmt(entry.data.date)}
        {untranslated && <> · ko</>}
        {entry.data.url && <> · <a href={entry.data.url}>{new URL(entry.data.url).host}</a></>}
      </p>
      <p class="summary">{entry.data.summary}</p>
    </header>
    <article class="prose" lang={langOf(entry)}>
      <Content />
    </article>
  </main>
</Base>

<style>
  .head { margin: 2.5rem 0 0; }
  h1 { margin: 0 0 0.4rem; }
  .head .mono { margin: 0; }
  .head .dot { margin-right: 0.35rem; }
  .summary { color: var(--muted); margin: 0.75rem 0 0; }
</style>
