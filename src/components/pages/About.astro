---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = (path: string) => (lang === 'en' ? `/en${path}` : path);

const S = 'width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const icons: Record<string, string> = {
  education: `<svg viewBox="0 0 24 24" ${S}><path d="M12 4 2.5 8.5 12 13l9.5-4.5Z"/><path d="M6 10.8V16c0 0 2.4 2 6 2s6-2 6-2v-5.2"/><path d="M21.5 8.5V14"/></svg>`,
  experience: `<svg viewBox="0 0 24 24" ${S}><rect x="3" y="8" width="18" height="11" rx="2"/><path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>`,
  activities: `<svg viewBox="0 0 24 24" ${S}><path d="M5 21V4"/><path d="M5 5h11l-2.5 3.5L16 12H5"/></svg>`,
  skills: `<svg viewBox="0 0 24 24" ${S}><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="14" cy="7" r="2.2" fill="var(--paper)"/><circle cx="8" cy="12" r="2.2" fill="var(--paper)"/><circle cx="16" cy="17" r="2.2" fill="var(--paper)"/></svg>`,
  projects: `<svg viewBox="0 0 24 24" ${S}><path d="M3 8a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>`,
  channels: `<svg viewBox="0 0 24 24" ${S}><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
  github: `<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.24 2.76.12 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>`,
  blog: `<svg viewBox="0 0 24 24" ${S}><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`,
  mail: `<svg viewBox="0 0 24 24" ${S}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`,
};

const data = {
  ko: {
    hello: '안녕하세요, 데이터로 뭔가 만드는 Qjin입니다.',
    sub: '영국에서 데이터 사이언스를 공부하면서, 틈틈이 이것저것 만듭니다.',
    education: [
      { school: 'University of Sheffield', degree: 'MSc Data Science', period: '2025 –' },
      { school: '한국공학대학교', degree: '컴퓨터전자공학 학사', period: '2020 – 2024' },
    ],
    company: 'MetaSysnet',
    role: 'Database Division Manager · Seoul',
    period: '2020.01 – 2024.02',
    summary: '국가 기관 데이터 구축 프로젝트에서 데이터 파이프라인과 현장 도구를 개발. 대규모 비정형 데이터 정리, 사업 계획 수립, 팀 운영.',
    workProjects: [
      { name: 'DAMP', tech: 'C#', desc: '미술 기록물 디지털화·보존 프로젝트 관리 프로그램. 데이터 정제·배포·검수, 관리자 통계, 실시간 관리' },
      { name: 'KolisMods', tech: 'Python', desc: '국립중앙도서관 국가전거파일 구축. MODS 데이터 수집, 필요한 필드 추출·변환' },
      { name: 'LMM', tech: 'Python · Qt', desc: '국회도서관 문서 DB 구축. 메타데이터 검색, 정확성 자동 검증, CSV·Excel 입출력' },
    ],
    activities: [
      {
        name: '지하철역 혼잡도 예측 모델 연구 · 1저자',
        detail: '딥러닝(MLP) 기반 혼잡도 동적 분석·예측 — 한국컴퓨터정보학회 동계학술대회 논문. AIS Lab(대학 연합 동아리) 활동으로 진행',
        period: '2023.11 – 2024.01',
      },
    ],
    skills: [
      { name: 'Python', note: '메타데이터 도구, 자동화' },
      { name: 'R', note: '통계 분석 · 시각화' },
      { name: 'SQL · Database', note: '서지 DB 구축 · 운영' },
      { name: 'C# · Qt', note: '현장용 데스크톱 도구' },
      { name: 'TypeScript · Web', note: 'Astro, Next.js' },
      { name: 'Tools', note: 'Git · GitHub Actions · Cloudflare' },
    ],
    projects: [
      { name: 'QRA', desc: '웹 기반 원격 제어 플랫폼', href: '/works/qra', status: 'live' },
      { name: '영국 철도 회복 분석', desc: '코로나 이후 회복의 지역 불균형', href: '/works/uk-rail-recovery', status: 'archived' },
      { name: '철도 지연 학위논문', desc: '진행 중', href: '/works/rail-delay-dissertation', status: 'wip' },
    ],
    worksNote: '자세한 기록은',
    channels: [
      { label: 'GitHub', href: 'https://github.com/Qjins', icon: 'github' },
      { label: 'Blog', href: 'https://qjin.tistory.com', icon: 'blog' },
      { label: 'Mail', href: 'mailto:qjink126@gmail.com', icon: 'mail' },
    ],
  },
  en: {
    hello: "Hi, I'm Qjin — I make things with data.",
    sub: "I'm studying data science in the UK and building things on the side.",
    education: [
      { school: 'University of Sheffield', degree: 'MSc Data Science', period: '2025 –' },
      { school: 'Tech University of Korea', degree: 'BSc Computer and Electronics Engineering', period: '2020 – 2024' },
    ],
    company: 'MetaSysnet',
    role: 'Database Division Manager · Seoul',
    period: 'Jan 2020 – Feb 2024',
    summary: 'Built data pipelines and field tools for national data construction projects. Large-scale unstructured data, business planning, team management.',
    workProjects: [
      { name: 'DAMP', tech: 'C#', desc: 'Management program for an art-records digitisation project — data refinement, distribution, inspection, admin statistics, real-time oversight' },
      { name: 'KolisMods', tech: 'Python', desc: 'National Authority File project, National Library of Korea — collects MODS data, extracts and converts required fields' },
      { name: 'LMM', tech: 'Python · Qt', desc: 'Document DB project, National Assembly Library — metadata search, automatic verification, CSV/Excel import·export' },
    ],
    activities: [
      {
        name: 'Subway congestion prediction model · first author',
        detail: 'Deep-learning (MLP) dynamic analysis and prediction of station congestion — paper at the KSCI winter conference, done through AIS Lab, an inter-university club',
        period: 'Nov 2023 – Jan 2024',
      },
    ],
    skills: [
      { name: 'Python', note: 'metadata tools, automation' },
      { name: 'R', note: 'statistical analysis · visualisation' },
      { name: 'SQL · Database', note: 'bibliographic DB projects' },
      { name: 'C# · Qt', note: 'desktop tools for field work' },
      { name: 'TypeScript · Web', note: 'Astro, Next.js' },
      { name: 'Tools', note: 'Git · GitHub Actions · Cloudflare' },
    ],
    projects: [
      { name: 'QRA', desc: 'web-based remote access platform', href: '/works/qra', status: 'live' },
      { name: 'The uneven recovery of UK rail', desc: 'what the national average hides', href: '/works/uk-rail-recovery', status: 'archived' },
      { name: 'Rail delay dissertation', desc: 'in progress', href: '/works/rail-delay-dissertation', status: 'wip' },
    ],
    worksNote: 'Full stories in',
    channels: [
      { label: 'GitHub', href: 'https://github.com/Qjins', icon: 'github' },
      { label: 'Blog', href: 'https://qjin.tistory.com', icon: 'blog' },
      { label: 'Mail', href: 'mailto:qjink126@gmail.com', icon: 'mail' },
    ],
  },
}[lang];
---
<Base lang={lang} title="about" description={t(lang, 'aboutDesc')}>
  <main class="wrap narrow" style="margin-inline: auto;">
    <h1>about</h1>
    <p class="hello">{data.hello}</p>
    <p class="sub">{data.sub}</p>

    <h2 class="label"><span class="ico" set:html={icons.education} /> education</h2>
    <ul class="rows">
      {data.education.map((e) => (
        <li>
          <div>
            <strong>{e.school}</strong>
            <p class="detail">{e.degree}</p>
          </div>
          <span class="mono date">{e.period}</span>
        </li>
      ))}
    </ul>

    <h2 class="label"><span class="ico" set:html={icons.experience} /> experience</h2>
    <div class="exp-head">
      <div>
        <strong>{data.company}</strong>
        <p class="detail">{data.role}</p>
      </div>
      <span class="mono date">{data.period}</span>
    </div>
    <p class="detail summary">{data.summary}</p>
    <ul class="grid">
      {data.workProjects.map((w) => (
        <li class="card">
          <strong>{w.name}</strong>
          <span class="mono meta">{w.tech}</span>
          <p class="detail">{w.desc}</p>
        </li>
      ))}
    </ul>

    <h2 class="label"><span class="ico" set:html={icons.activities} /> activities</h2>
    <ul class="rows">
      {data.activities.map((a) => (
        <li>
          <div>
            <strong>{a.name}</strong>
            <p class="detail">{a.detail}</p>
          </div>
          <span class="mono date">{a.period}</span>
        </li>
      ))}
    </ul>

    <h2 class="label"><span class="ico" set:html={icons.skills} /> skills</h2>
    <ul class="grid skills">
      {data.skills.map((s) => (
        <li class="card">
          <strong>{s.name}</strong>
          <p class="detail">{s.note}</p>
        </li>
      ))}
    </ul>

    <h2 class="label"><span class="ico" set:html={icons.projects} /> projects</h2>
    <ul class="rows">
      {data.projects.map((w) => (
        <li>
          <span class={`dot ${w.status}`} aria-hidden="true"></span>
          <a href={p(w.href)}>{w.name}</a>
          <span class="detail">{w.desc}</span>
        </li>
      ))}
    </ul>
    <p class="detail">{data.worksNote} <a href={p('/works')}>works</a> →</p>

    <h2 class="label"><span class="ico" set:html={icons.channels} /> channels</h2>
    <div class="chips">
      {data.channels.map((c) => (
        <a class="chip" href={c.href} rel={c.icon === 'github' ? 'me' : undefined}>
          <span class="ico" set:html={icons[c.icon]} />
          {c.label}
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  h1 { margin-bottom: 0.25rem; }
  .hello { font-size: 1.3rem; font-weight: 500; color: var(--petrol); margin: 2.2rem 0 0.3rem; line-height: 1.5; }
  .sub { color: var(--muted); margin: 0; }
  .detail { color: var(--muted); font-size: 0.95rem; margin: 0.15rem 0 0; }
  .label { display: flex; align-items: center; gap: 0.5rem; }
  .ico { display: inline-flex; }
  .ico :global(svg) { width: 15px; height: 15px; display: block; }
  .rows li { align-items: baseline; }
  .rows .dot { flex-shrink: 0; align-self: center; }
  .rows .date { margin-left: auto; white-space: nowrap; color: var(--muted); }
  .exp-head { display: flex; align-items: baseline; gap: 0.75rem; }
  .exp-head .date { margin-left: auto; white-space: nowrap; color: var(--muted); }
  .summary { margin-top: 0.4rem; }
  .grid { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.75rem; }
  .card { border: 1px solid var(--line); border-radius: 6px; padding: 0.8rem 1rem; }
  .card .mono.meta { margin-left: 0.5rem; }
  .skills .card { padding: 0.6rem 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    border: 1px solid var(--line); border-radius: 999px;
    padding: 0.45rem 1rem; text-decoration: none; font-size: 0.9rem;
  }
  .chip:hover { border-color: var(--coral); color: var(--coral); }
  .chip .ico :global(svg) { width: 16px; height: 16px; }
</style>
