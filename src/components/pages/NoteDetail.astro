---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langOf, slugOf } from '../../lib/content';
import EditLink from '../EditLink.astro';
import type { Lang } from '../../lib/i18n';

interface Props { lang: Lang; entry: CollectionEntry<'notes'> }
const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base lang={lang} title={entry.data.title}>
  <main class="wrap narrow" style="margin-inline: auto;">
    <header class="head">
      <p class="mono meta">{fmt(entry.data.date)}{lang === 'en' && langOf(entry) === 'ko' && ' · ko'}</p>
      <h1>{entry.data.title} <EditLink item={`collection/notes${langOf(entry) === 'en' ? 'En' : 'Ko'}/item/${slugOf(entry)}`} /></h1>
    </header>
    <article class="prose" lang={langOf(entry)}>
      <Content />
    </article>
  </main>
</Base>

<style>
  .head { margin: 2.5rem 0 0; }
  .head p { margin: 0 0 0.3rem; }
  h1 { margin: 0; }
</style>
