---
// CMS 모드(npm run cms)에서만 보이는 연필. 누르면 해당 Keystatic 편집 화면.
// 프로덕션 빌드에서는 렌더링되지 않는다.
interface Props { item: string; label?: string }
const { item, label = 'edit' } = Astro.props;
const show = !!process.env.KEYSTATIC;
---
{show && (
  <a class="edit-pencil" href={`/keystatic/${item}`} title={label} aria-label={label}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
  </a>
)}

<style>
  .edit-pencil {
    display: inline-flex;
    margin-left: 0.5rem;
    color: var(--muted);
    vertical-align: middle;
    opacity: 0.7;
  }
  .edit-pencil:hover { color: var(--coral); opacity: 1; }
</style>
