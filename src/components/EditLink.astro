---
// 편집 연필. 해당 Keystatic 편집 화면을 새 탭으로 연다.
// - 로컬 CMS(npm run cms): 항상 보임
// - 배포판: 기본 숨김. qjins.com/#edit 로 켜고 #editoff 로 끈다(본인용 스위치).
//   실제 편집은 어차피 GitHub 로그인(본인 계정)을 통과해야 가능하다.
interface Props { item: string; label?: string }
const { item, label = 'edit' } = Astro.props;
const always = !!process.env.KEYSTATIC;
---
<a class:list={['edit-pencil', { always }]} href={`/keystatic/${item}`} target="_blank" rel="noopener" title="새 탭에서 편집. 저장하면 이 화면에 반영됩니다" aria-label={label}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
</a>

<style>
  .edit-pencil {
    display: none;
    margin-left: 0.5rem;
    color: var(--muted);
    vertical-align: middle;
    opacity: 0.7;
  }
  .edit-pencil.always,
  :global(:root.edit-mode) .edit-pencil { display: inline-flex; }
  .edit-pencil:hover { color: var(--coral); opacity: 1; }
</style>
