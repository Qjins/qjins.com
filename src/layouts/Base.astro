---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Sparkline from '../components/Sparkline.astro';
import { t, localePath, switchPath, type Lang } from '../lib/i18n';

interface Props { title?: string; description?: string; lang?: Lang }
const { title, lang = 'ko', description = t(lang, 'siteDesc') } = Astro.props;
const pageTitle = title ? `${title} · qjins` : t(lang, 'siteTitle');
const nav = ['works', 'notes', 'blog', 'now', 'about'] as const;
const path = Astro.url.pathname;
const koPath = lang === 'ko' ? path : switchPath(path);
const enPath = lang === 'en' ? path : switchPath(path);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="ko" href={new URL(koPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <!--
      Cloudflare Web Analytics (쿠키 없음): 자동 주입 사용 중.
      대시보드 > Web Analytics > qjins.com이 RUM "Enable"(auto-inject)이라
      엣지에서 beacon이 자동 삽입된다. 여기에 수동 스니펫을 추가하면
      이중 집계되니 넣지 말 것. Cloudflare 밖으로 이전할 때만 수동 설치 필요.
    -->
  </head>
  <body>
    <header class="wrap site-header">
      <a href={localePath(lang, '/')} class="home-link" aria-label="Qjins home">
        <Logo height={24} />
        <span class="wordmark">Qjins</span>
      </a>
      <nav aria-label={lang === 'ko' ? '주 메뉴' : 'Main menu'}>
        {nav.map((item) => (
          <a href={localePath(lang, `/${item}`)} class="mono" aria-current={path.replace(/^\/en/, '').startsWith(`/${item}`) ? 'page' : undefined}>
            {item}
          </a>
        ))}
        <a href={switchPath(path)} class="mono lang-switch" aria-label={lang === 'ko' ? 'Switch to English' : '한국어로 전환'}>
          {lang === 'ko' ? 'EN' : 'KO'}
        </a>
        <button id="theme-toggle" aria-label={lang === 'ko' ? '테마 전환' : 'Toggle theme'}>◐</button>
      </nav>
    </header>

    <slot />

    <footer class="wrap site-footer">
      <Sparkline />
      <span class="mono meta">qjins.com</span>
      <span class="links mono">
        <a href="mailto:qjink126@gmail.com">mail</a>
        <a href="https://github.com/Qjins" rel="me">github</a>
        <a href="/keystatic" rel="nofollow">login</a>
      </span>
    </footer>

    <script is:inline>
      // 편집 연필 스위치 (본인용): #edit 로 켜고 #editoff 로 끔.
      // 연필은 링크일 뿐이고, 실제 편집은 Keystatic GitHub 로그인을 통과해야 한다.
      if (location.hash === '#edit') localStorage.setItem('qjins-edit', '1');
      if (location.hash === '#editoff') localStorage.removeItem('qjins-edit');
      if (localStorage.getItem('qjins-edit')) document.documentElement.classList.add('edit-mode');

      // 세션 한정 테마 토글. localStorage 없음. 새로고침하면 prefers-color-scheme으로 복귀.
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme || (systemDark ? 'dark' : 'light');
        root.dataset.theme = current === 'dark' ? 'light' : 'dark';
      });
    </script>
  </body>
</html>

<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; padding-top: 1.5rem; padding-bottom: 0.5rem; }
  .home-link { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; }
  .wordmark { font-weight: 700; color: var(--petrol); letter-spacing: -0.01em; }
  nav { display: flex; align-items: center; gap: 1.1rem; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: var(--coral); }
  .lang-switch { border-left: 1px solid var(--line); padding-left: 1.1rem; }
  #theme-toggle { background: none; border: 0; cursor: pointer; font-size: 1rem; color: var(--muted); padding: 0.2rem; line-height: 1; }
  #theme-toggle:hover { color: var(--coral); }
  .site-footer { display: flex; align-items: center; gap: 0.9rem; padding-top: 4rem; padding-bottom: 2.5rem; }
  .site-footer .links { margin-left: auto; display: flex; gap: 0.9rem; }
</style>
