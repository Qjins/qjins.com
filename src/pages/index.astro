---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pulse from '../components/Pulse.astro';
import { services } from '../config/services';

const works = (await getCollection('works')).sort((a, b) => +b.data.date - +a.data.date);
const notes = (await getCollection('notes')).sort((a, b) => +b.data.date - +a.data.date);

const recent = [
  ...works.map((w) => ({ kind: 'work', title: w.data.title, href: `/works/${w.id}`, date: w.data.date })),
  ...notes.map((n) => ({ kind: 'note', title: n.data.title, href: `/notes/${n.id}`, date: n.data.date })),
]
  .sort((a, b) => +b.date - +a.date)
  .slice(0, 5);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base>
  <div class="wrap">
    <Pulse />

    <p class="intro">
      데이터로 뭔가 만드는 1인 스튜디오.<br />
      주인공은 제가 아니라 <a href="/works">제가 만드는 것들</a>입니다.
    </p>

    <h2 class="label">services</h2>
    {services.length === 0 ? (
      <p class="empty">아직 없음 — 첫 서비스가 lab에서 만들어지는 중입니다. 완성되면 여기에 걸립니다.</p>
    ) : (
      <ul class="cards">
        {services.map((s) => (
          <li>
            <a href={s.url}>
              <span class={`dot ${s.status}`} aria-hidden="true"></span>
              <strong>{s.name}</strong>
              <span class="mono meta">{s.zone}.qjins.com</span>
              <p>{s.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}

    <h2 class="label">recent</h2>
    <ul class="rows">
      {recent.map((r) => (
        <li>
          <span class="mono meta kind">{r.kind}</span>
          <a href={r.href}>{r.title}</a>
          <span class="mono date">{fmt(r.date)}</span>
        </li>
      ))}
    </ul>

    <h2 class="label">contact</h2>
    <p class="mono contact">
      <a href="mailto:qjink126@gmail.com">qjink126@gmail.com</a> · <a href="https://github.com/Qjins" rel="me">github</a>
    </p>
  </div>
</Base>

<style>
  .intro { font-size: 1.35rem; line-height: 1.6; margin: 2.5rem 0 0; color: var(--petrol); font-weight: 500; }
  .intro a { text-decoration-color: var(--coral); }
  .empty { color: var(--muted); border: 1px dashed var(--line); border-radius: 6px; padding: 1rem 1.25rem; margin: 0; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.75rem; }
  .cards a { display: block; border: 1px solid var(--line); border-radius: 6px; padding: 0.9rem 1.1rem; text-decoration: none; }
  .cards a:hover { border-color: var(--coral); color: inherit; }
  .cards p { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .cards .dot { margin-right: 0.5rem; }
  .cards .mono.meta { margin-left: 0.5rem; }
  .kind { width: 2.6rem; flex-shrink: 0; }
  .contact { font-size: 0.9rem; }
</style>
