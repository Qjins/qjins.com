---
import NoteDetail from '../../../components/pages/NoteDetail.astro';
import { getNotes, slugOf } from '../../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes('en');
  return notes.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<NoteDetail lang="en" entry={entry} />
