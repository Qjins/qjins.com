---
import { getCollection, render } from 'astro:content';
import { execSync } from 'node:child_process';
import { statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';

const [entry] = await getCollection('now');
const { Content } = await render(entry);

// 마지막 수정 날짜: git 이력 우선, 없으면 파일 mtime
const nowPath = 'src/content/now/now.md';
let updated = '';
try {
  updated = execSync(`git log -1 --format=%cs -- ${nowPath}`, { encoding: 'utf-8' }).trim();
} catch { /* git 없음 */ }
if (!updated) {
  try {
    updated = statSync(join(process.cwd(), nowPath)).mtime.toISOString().slice(0, 10);
  } catch { /* 파일 없음 */ }
}
---
<Base title="now" description="요즘 하는 일">
  <main class="wrap narrow" style="margin-inline: auto;">
    <h1>now</h1>
    {updated && <p class="mono meta">마지막 수정 {updated}</p>}
    <article class="prose">
      <Content />
    </article>
  </main>
</Base>

<style>
  h1 { margin-bottom: 0.25rem; }
</style>
